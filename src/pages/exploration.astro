---
import Layout from "../layouts/Layout.astro";
import PlotFigure from "../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import ConsommationConversation from "../assets/ConsommationConversation.json";

const donneesTransformees = ConsommationConversation.flatMap((d) => [
    { nom_modele: d.modelA, consommation: +d.consommationA },
    { nom_modele: d.modelB, consommation: +d.consommationB },
]).filter((d) => d.consommation > 0);
---

<Layout>
    <main
        class="min-h-screen bg-slate-50 px-4 pb-10 pt-4 text-slate-800 sm:px-6 lg:pb-16 lg:pt-8"
        aria-label="Exploration de la consommation énergétique des modèles d'intelligence artificielle"
    >
        <section
            class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 lg:p-10"
        >
            <div class="mb-6 max-w-3xl">
                <p
                    class="mb-2 text-sm font-semibold uppercase tracking-wider text-orange-600"
                >
                    La révélation
                </p>
                <h2 class="text-2xl font-bold text-slate-800 sm:text-3xl">
                    Les modèles d’IA ne consomment pas tous la même quantité
                    d’électricité
                </h2>
            </div>

            <div class="max-w-3xl space-y-4 text-lg leading-8 text-slate-600">
                <p>
                    Ces données révèlent qu'il n'y a pas « une » consommation
                    type pour l'IA : chaque modèle consomme différemment, créant
                    une inégalité extrême. Sur les 25 modèles retenus, les 5
                    premiers écrasent complètement les autres.
                </p>
                <p>
                    <strong class="text-slate-800">Mistral-large-2512 </strong>
                    est le plus énergivore, avec une consommation de
                    <strong class="text-slate-800"> 7,140 Wh</strong> par réponse.
                    Il appartient à la catégorie XL : pour fonctionner, il exige une
                    quantité importante de mémoire RAM sur les serveurs, ce qui peut
                    expliquer sa demande en électricité. L'interaction qui permet
                    de comparer un modèle d’IA avec un appareil électroménager nous
                    révèle que pour une heure d’utilisation d’un réfrigérateur, le
                    modèle IA consomme autant pour 15 réponses. Selon le modèle choisi,
                    le nombre de réponses équivalentes à une heure d' électroménager
                    varie.
                </p>
                <p class="text-sm text-slate-500">
                    Sources : Compar:IA, consultées le 20 octobre 2026.
                    Consommations estimées, médiane d'au moins 10 réponses par
                    modèle.
                </p>
            </div>
        </section>

        <nav
            class="mt-10 flex flex-wrap gap-2 rounded-2xl border border-slate-200 bg-white p-2 shadow-sm"
            aria-label="Graphiques de l'exploration"
            role="tablist"
        >
            <button
                type="button"
                role="tab"
                class="tab-button rounded-xl px-5 py-4 text-base font-semibold text-white transition bg-orange-600 hover:bg-orange-700"
                data-tab="histogramme"
                id="tab-button-histogramme"
                aria-controls="tab-histogramme"
                aria-selected="true"
            >
                Modèles les plus énergivores
            </button>
            <button
                type="button"
                role="tab"
                class="tab-button rounded-xl px-5 py-4 text-base font-semibold text-slate-600 transition hover:bg-orange-50 hover:text-orange-700"
                data-tab="evolution"
                id="tab-button-evolution"
                aria-controls="tab-evolution"
                aria-selected="false"
            >
                Évolution dans le temps
            </button>
            <button
                type="button"
                role="tab"
                class="tab-button rounded-xl px-5 py-4 text-base font-semibold text-slate-600 transition hover:bg-orange-50 hover:text-orange-700"
                data-tab="comparaison"
                id="tab-button-comparaison"
                aria-controls="tab-comparaison"
                aria-selected="false"
            >
                Comparaison avec l'électroménager
            </button>
        </nav>

        <div class="mt-6">
            <section
                id="tab-histogramme"
                data-tab-panel="histogramme"
                role="tabpanel"
                aria-labelledby="tab-button-histogramme"
                tabindex="0"
                class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 lg:p-10"
            >
                <div class="mb-2 max-w-3xl">
                    <p
                        class="mb-2 text-sm font-semibold uppercase tracking-wider text-orange-600"
                    >
                        L'histogramme des modèles d'IA
                    </p>
                    <h2 class="text-2xl font-bold text-slate-800 sm:text-3xl">
                        Le top 25 des modèles les plus énergivores
                    </h2>
                </div>

                <div
                    class="grid items-center gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-12"
                >
                    <div class="max-w-xl">
                        <p class="text-lg font-bold leading-8 text-slate-600">
                            Quel est le modèle IA le plus énergivore ?
                        </p>
                        <p class="mt-5 leading-7 text-slate-500">
                            Le modèle le plus énergivore est Mistral-large-4-0
                            avec une consommation par requête hors norme qui
                            écrase complètement le reste du classement.
                        </p>

                        <p class="mt-2 text-xs text-slate-600">
                            Sources : données récoltées par le Ministère de la
                            Culture, mises à jour tous les jours (dernière mise
                            à jour le 20 octobre 2026). Ce jeu de données ne
                            précise ni l'énergie utilisée pour entraîner les
                            modèles, ni la localisation des data centers (en
                            France ou non), ni l'unité des valeurs de
                            consommation.
                        </p>
                    </div>
                    <div class="min-w-0 overflow-x-auto">
                        <PlotFigure
                            options={{
                                marginLeft: 150,
                                height: 600,

                                x: {
                                    label: "Consommation moyenne  →",
                                    domain: [0, 0.05],
                                },
                                y: {
                                    label: "Modèle IA",
                                },

                                marks: [
                                    Plot.barX(
                                        donneesTransformees,
                                        Plot.groupY(
                                            { x: "mean" },
                                            {
                                                x: "consommation",
                                                y: "nom_modele",
                                                fill: "green",
                                                sort: {
                                                    y: "x",
                                                    reverse: true,
                                                    limit: 25,
                                                },
                                            },
                                        ),
                                    ),
                                    Plot.ruleX([0]),
                                ],
                            }}
                        />
                    </div>
                </div>
            </section>
            <section
                id="tab-evolution"
                data-tab-panel="evolution"
                hidden
                role="tabpanel"
                aria-labelledby="tab-button-evolution"
                tabindex="0"
                class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 lg:p-10"
            >
                <div class="mb-2 max-w-3xl">
                    <p
                        class="mb-2 text-sm font-semibold uppercase tracking-wider text-orange-600"
                    >
                        L'évolution dans le temps
                    </p>
                    <h2 class="text-2xl font-bold text-slate-800 sm:text-3xl">
                        Consommation énergétique d'une réponse d'IA selon sa
                        taille et date de sortie
                    </h2>
                </div>

                <div
                    class="grid items-center gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-12"
                >
                    <div class="max-w-xl">
                        <p class="text-lg font-bold leading-8 text-slate-600">
                            La consommation énergétique d'un modèle d'IA
                            est-elle liée à sa date de sortie ?
                        </p>
                        <p class="mt-5 leading-7 text-slate-500">
                            Les modèles les plus récents sont en majorité ceux
                            qui consomment le plus. On peut voir une absence de
                            modèles XS ou S depuis 2026 et une accumulation de
                            modèles L et XL.
                        </p>
                        <p class="mt-2 text-xs text-slate-600">
                            Sources : estimations Compar:IA, données récoltées
                            par le Ministère de la Culture, mises à jour tous
                            les jours (dernière mise à jour le 20 octobre 2026).
                        </p>
                    </div>
                    <figure class="min-w-0 overflow-x-auto">
                        <div id="v3"></div>
                        <figcaption class="mt-3 text-xs text-slate-600">
                            Un point par modèle d'IA. Consommation médiane par
                            réponse en Wh, échelle logarithmique ; couleur :
                            taille du modèle. Estimations Compar:IA (modèles
                            ayant au moins 10 mesures).
                        </figcaption>
                    </figure>
                </div>
            </section>
            <section
                id="tab-comparaison"
                data-tab-panel="comparaison"
                hidden
                role="tabpanel"
                aria-labelledby="tab-button-comparaison"
                tabindex="0"
                class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 lg:p-10"
            >
                <div class="mb-2 max-w-3xl">
                    <p
                        class="mb-2 text-sm font-semibold uppercase tracking-wider text-orange-600"
                    >
                        La comparaison
                    </p>
                    <h2 class="text-2xl font-bold text-slate-800 sm:text-3xl">
                        Consommation de l'IA comparée à celle de
                        l'électroménager du quotidien
                    </h2>
                    <p class="mt-3 text-lg font-bold leading-8 text-slate-600">
                        Intelligence artificielle ou électroménager : qui est le
                        plus gourmand en électricité ?
                    </p>
                    <p class="mt-5 leading-7 text-slate-500">
                        Évaluez l'impact énergétique d'un modèle d'IA (ex :
                        gemini-3.1-pro-preview) face à vos appareils du
                        quotidien.
                    </p>
                </div>

                <div class="mb-6 flex flex-wrap gap-6">
                    <label
                        class="grid gap-1 text-sm font-medium text-slate-700"
                    >
                        Appareil
                        <select
                            id="v4-appareil"
                            class="rounded-lg border border-slate-300 px-3 py-2"
                        ></select>
                    </label>
                    <label
                        class="grid gap-1 text-sm font-medium text-slate-700"
                    >
                        Modèle d'IA
                        <select
                            id="v4-modele"
                            class="rounded-lg border border-slate-300 px-3 py-2"
                        ></select>
                    </label>
                </div>

                <p id="v4-phrase" class="text-lg leading-8 text-slate-800"></p>
                <p id="v4-detail" class="mt-1 text-sm text-slate-500"></p>

                <figure class="mt-6 min-w-0 overflow-x-auto">
                    <div id="v4"></div>
                    <figcaption class="mt-3 text-xs text-slate-600">
                        Énergie d'une heure d'appareil (moyenne sur 24 h)
                        comparée à celle d'une réponse du modèle choisi
                        (médiane, estimation), en Wh, échelle logarithmique.
                        Sources : ADEME le 29 janvier 2026 ; estimations
                        Compar:IA, données récoltées par le Ministère de la
                        Culture (dernière mise à jour le 20 octobre 2026).
                    </figcaption>
                </figure>
            </section>
        </div>
        <section
            aria-labelledby="conclusion-title"
            class="mt-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 lg:p-10"
        >
            <h2
                id="conclusion-title"
                class="mb-2 text-sm font-semibold uppercase tracking-wider text-orange-600"
            >
                Conclusion
            </h2>
            <p class="text-lg leading-8 text-slate-700 sm:text-xl">
                À travers notre analyse des données, nous avons pu constater que
                les modèles d'IA deviennent de plus en plus puissantes,
                entraînant une hausse de leur consommation électrique. En effet,
                plus la mémoire de ram est grande, plus le modèle sera
                énergivore. L'IA la plus énergivore est Mistral, catégorisé XL.
                Un modèle consomme autant en donnant X réponse qu'un appareil
                électroménager pendant 1 heure. L'utilisateur doit donc adapté
                son modèle d'IA en fonction de sa requête. Ne pas prendre un
                modèle énergivore comme Mistral simplement pour chercher une
                recette. En choisissant un plus petit modèle que d'habitude,
                c'est déjà réduire l'impact environnemental dû à la requête.
            </p>
        </section>
    </main>
</Layout>

<script>
    const tabButtons =
        document.querySelectorAll<HTMLButtonElement>(".tab-button");
    const tabPanels =
        document.querySelectorAll<HTMLElement>("[data-tab-panel]");

    for (const button of tabButtons) {
        button.addEventListener("click", () => {
            const tab = button.dataset.tab;
            if (!tab) return;

            for (const otherButton of tabButtons) {
                const isActive = otherButton === button;
                otherButton.setAttribute("aria-selected", String(isActive));
                otherButton.classList.toggle("bg-orange-600", isActive);
                otherButton.classList.toggle("text-white", isActive);
                otherButton.classList.toggle("hover:bg-orange-700", isActive);
                otherButton.classList.toggle("text-slate-600", !isActive);
                otherButton.classList.toggle("hover:bg-orange-50", !isActive);
                otherButton.classList.toggle(
                    "hover:text-orange-700",
                    !isActive,
                );
            }

            for (const panel of tabPanels) {
                panel.hidden = panel.dataset.tabPanel !== tab;
            }
        });

        button.addEventListener("keydown", (event) => {
            if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key))
                return;

            event.preventDefault();
            const buttons = Array.from(tabButtons);
            const currentIndex = buttons.indexOf(button);
            const nextIndex =
                event.key === "Home"
                    ? 0
                    : event.key === "End"
                      ? buttons.length - 1
                      : (currentIndex +
                            (event.key === "ArrowRight" ? 1 : -1) +
                            buttons.length) %
                        buttons.length;
            buttons[nextIndex].focus();
            buttons[nextIndex].click();
        });
    }
</script>

<script>
    import * as Plot from "@observablehq/plot";

    const [conso, infos] = await Promise.all([
        fetch("/data/ConsommationConversation.json").then((r) => r.json()),
        fetch("/data/ConsommationModeles.json").then((r) => r.json()),
    ]);

    // accepte les deux nommages possibles
    const idDe = (x: any) => x.id ?? x.human_id;
    const sortieDe = (x: any) => x.sortie ?? x.release_date;
    const tailleDe = (x: any) => x.taille ?? x.size_class;

    const groupes = new Map<string, number[]>();
    for (const d of conso.flatMap((d: any) => [
        { nom: d.modelA, c: +d.consommationA },
        { nom: d.modelB, c: +d.consommationB },
    ])) {
        if (!d.nom || !(d.c > 0)) continue;
        if (!groupes.has(d.nom)) groupes.set(d.nom, []);
        groupes.get(d.nom)!.push(d.c);
    }

    const parModele: any[] = [];
    for (const [nom, v] of groupes) {
        if (v.length < 10) continue;
        const info = infos.find((x: any) => idDe(x) === nom);
        const sortie = info && sortieDe(info);
        if (!sortie) continue;
        v.sort((a: number, b: number) => a - b);
        const med =
            v.length % 2
                ? v[(v.length - 1) / 2]
                : (v[v.length / 2 - 1] + v[v.length / 2]) / 2;
        parModele.push({
            nom,
            n: v.length,
            wh: med * 1000, // kWh → Wh
            sortie: new Date(sortie),
            taille: tailleDe(info) || "non renseignée",
        });
    }
    if (!parModele.length)
        console.warn(
            "Graphique v3 vide : aucun modèle n'a d'id + date de sortie correspondant dans ConsommationModeles.json",
        );

    document.querySelector("#v3")!.append(
        Plot.plot({
            height: 500,
            marginLeft: 60,
            ariaLabel:
                "Nuage de points : chaque point est un modèle d'IA, placé selon sa date de sortie (de juillet 2024 à avril 2026) et sa consommation par réponse en Wh, de 0,03 à 5,92, sur une échelle logarithmique. La couleur indique la taille, de XS à XL. Les modèles XS et S sont en bas du graphique, les XL en haut, et les points sont répartis sur toute la période.",
            x: { label: "Date de sortie →" },
            y: { type: "log", label: "↑ Wh par réponse (médiane)", grid: true },
            color: {
                legend: true,
                label: "Taille du modèle",
                domain: ["XS", "S", "M", "L", "XL", "non renseignée"],
                range: [
                    "#A8DDB5",
                    "#74C476",
                    "#41AB5D",
                    "#238B45",
                    "#00441B",
                    "#9AA5A8",
                ],
            },
            marks: [
                Plot.dot(parModele, {
                    x: "sortie",
                    y: "wh",
                    fill: "taille",
                    r: 5,
                    title: (d: any) => `${d.nom} (${d.n} mesures)`,
                }),
            ],
        }),
    );
</script>

<script>
    import * as Plot from "@observablehq/plot";

    const [conso, infos, appareilsBruts] = await Promise.all([
        fetch("/data/ConsommationConversation.json").then((r) => r.json()),
        fetch("/data/ConsommationModeles.json").then((r) => r.json()),
        fetch("/data/consommation_electromenager.json").then((r) => r.json()),
    ]);

    const idDe = (x: any) => x.id ?? x.human_id;
    const tailleDe = (x: any) => x.taille ?? x.size_class;
    const classeDe = (x: any) => x.classeEnergie ?? x.energy_class;

    const appareils = appareilsBruts
        .map((d: any) => ({
            appareil: d.appareil ?? d.nom,
            wh: +(d.consommationMoyenne ?? d.wh ?? d["consommation_Wh/h"]),
        }))
        .filter((d: any) => d.appareil && d.wh > 0)
        .sort((a: any, b: any) => a.appareil.localeCompare(b.appareil, "fr"));

    const groupes = new Map<string, number[]>();
    for (const d of conso.flatMap((d: any) => [
        { nom: d.modelA, c: +d.consommationA },
        { nom: d.modelB, c: +d.consommationB },
    ])) {
        if (!d.nom || !(d.c > 0)) continue;
        if (!groupes.has(d.nom)) groupes.set(d.nom, []);
        groupes.get(d.nom)!.push(d.c);
    }

    const modeles: any[] = [];
    for (const [modele, v] of groupes) {
        if (v.length < 10) continue;
        v.sort((a: number, b: number) => a - b);
        const med =
            v.length % 2
                ? v[(v.length - 1) / 2]
                : (v[v.length / 2 - 1] + v[v.length / 2]) / 2;
        modeles.push({ modele, n: v.length, wh: med * 1000 }); // kWh → Wh
    }
    modeles.sort((a: any, b: any) => a.modele.localeCompare(b.modele, "fr"));

    if (!appareils.length || !modeles.length)
        console.warn("Graphique v4 vide : vérifier les champs des JSON");

    const selA = document.querySelector("#v4-appareil") as HTMLSelectElement;
    const selM = document.querySelector("#v4-modele") as HTMLSelectElement;
    for (const d of appareils) selA.append(new Option(d.appareil, d.appareil));
    for (const d of modeles) selM.append(new Option(d.modele, d.modele));

    const nb = (x: number) =>
        x.toLocaleString("fr-FR", { maximumFractionDigits: x < 10 ? 1 : 0 });

    function dessiner() {
        const a = appareils.find((d: any) => d.appareil === selA.value);
        const m = modeles.find((d: any) => d.modele === selM.value);
        if (!a || !m) return;
        const eq = a.wh / m.wh;
        const info = infos.find((x: any) => idDe(x) === m.modele) ?? {};

        document.querySelector("#v4-phrase")!.innerHTML =
            `1 heure de <b>${a.appareil}</b> équivaut à environ <b>${nb(eq)}</b> réponses de <b>${m.modele}</b>.`;
        document.querySelector("#v4-detail")!.textContent =
            `Modèle : taille ${tailleDe(info) ?? "non renseignée"}, classe énergétique ${classeDe(info) ?? "non renseignée"} (médiane de ${m.n} mesures).`;

        document.querySelector("#v4")!.replaceChildren(
            Plot.plot({
                height: 240,
                marginLeft: 200,
                ariaLabel: `Comparaison sur une échelle logarithmique : une heure de ${a.appareil} consomme ${a.wh.toFixed(1)} Wh, une réponse de ${m.modele} consomme ${m.wh.toFixed(3)} Wh, soit un rapport de ${nb(eq)}.`,
                x: {
                    type: "log",
                    domain: [0.001, 10000],
                    label: "Énergie (Wh, échelle logarithmique) →",
                    grid: true,
                },
                y: { label: null },
                color: {
                    legend: false,
                    domain: ["appareil", "ia"],
                    range: ["#9AA5A8", "#238B45"],
                },
                marks: [
                    Plot.dot(
                        [
                            {
                                label: `1 h de ${a.appareil}`,
                                wh: a.wh,
                                type: "appareil",
                            },
                            {
                                label: `1 réponse (${m.modele})`,
                                wh: m.wh,
                                type: "ia",
                            },
                        ],
                        {
                            x: "wh",
                            y: "label",
                            r: 8,
                            fill: "type",
                            title: (d: any) =>
                                `${d.label} : ${d.wh.toFixed(3)} Wh`,
                        },
                    ),
                ],
            }),
        );
    }

    selA.addEventListener("change", dessiner);
    selM.addEventListener("change", dessiner);
    dessiner();
</script>
