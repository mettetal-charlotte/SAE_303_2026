---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main class="min-h-screen bg-slate-50 px-4 py-10 text-slate-800 sm:px-6 lg:py-16">
        <div class="mx-auto max-w-6xl">
            <section class="mb-8 rounded-3xl bg-gradient-to-br from-orange-600 via-orange-500 to-orange-400 px-6 py-8 text-white shadow-lg sm:px-10 sm:py-10">
                <p class="mb-2 text-sm font-semibold uppercase tracking-[0.2em] text-orange-100">
                    Informations
                </p>
                <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                    Mentions légales
                </h1>
            </section>

            <div class="grid gap-5 md:grid-cols-2">
                <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
                    <h2 class="mb-4 text-xl font-bold text-slate-900">
                        Éditeur du site
                    </h2>
                    <p class="leading-7 text-slate-600">
                        Yanis Chouhib et Charlotte Mettetal, étudiants en deuxième
                        année du BUT des Métiers du Mutlimédia et de l'Internet
                    </p>
                    <p class="mt-4 font-medium text-slate-700">
                        Adresse de contact :
                    </p>
                    <p class="mt-1 break-words leading-7 text-slate-600">
                        yanis.chouhib-forster@edu.univ-fcomte.fr<br />
                        charlotte.mettetal@edu.univ-fcomte.fr
                    </p>
                </section>

                <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
                    <h2 class="mb-4 text-xl font-bold text-slate-900">
                        Hébergement du site web
                    </h2>
                    <p class="leading-7 text-slate-600">
                        Netlify, Inc.<br />
                        44 Montgomery Street, Suite 300, San Francisco,<br />
                        Californie 94104,<br />
                        États-Unis.
                    </p>
                </section>

                <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 md:col-span-2">
                    <h2 class="mb-4 text-xl font-bold text-slate-900">
                        Nom de domaine
                    </h2>
                    <p class="leading-7 text-slate-600">
                        Infomaniak,<br />
                        Rue Eugène Marzio 25,<br />
                        1227 Genève,<br />
                        Suisse
                    </p>
                </section>
            </div>
        </div>
    </main>
</Layout>
